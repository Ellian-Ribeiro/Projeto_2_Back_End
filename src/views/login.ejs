<%- include('partials/header') %>

<section class="card auth-card">
    <h1>Login</h1>
    <p class="subtitle">Acesse o painel administrativo do E-commerce.</p>

    <form action="/auth/login" method="POST" class="form-stack">
        <div class="form-group">
            <label for="email">E-mail</label>
            <input type="text" id="email" name="email" value="<%= emailInformado %>" placeholder="admin@ecommerce.com">
        </div>

        <div class="form-group">
            <label for="senha">Senha</label>
            <input type="password" id="senha" name="senha" placeholder="Digite sua senha">
        </div>

        <button type="submit" class="btn btn-primary">Entrar</button>
    </form>

    <p class="auth-link">Não tem conta? <a href="/auth/register">Cadastre-se aqui</a>.</p>
</section>

<%- include('partials/footer') %>