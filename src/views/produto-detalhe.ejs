<%- include('partials/header') %>

<section class="card">
    <h1>Detalhes e Edição do Produto</h1>
    <p class="subtitle">ID do documento no MongoDB: <code><%= produto._id %></code></p>

    <form action="/produtos/atualizar" method="POST" class="form-grid">
        <input type="hidden" name="id" value="<%= produto._id %>">

        <div class="form-group">
            <label for="nome">Nome do Produto *</label>
            <input type="text" id="nome" name="nome" value="<%= produto.nome || '' %>">
        </div>

        <div class="form-group">
            <label for="preco">Preço (R$) *</label>
            <input type="text" id="preco" name="preco" value="<%= produto.preco !== undefined ? produto.preco : '' %>">
        </div>

        <div class="form-group">
            <label for="categoriaId">Categoria *</label>
            <select id="categoriaId" name="categoriaId">
                <option value="">-- Selecione --</option>
                <% categorias.forEach(c => { %>
                    <option value="<%= c._id %>" <%= produto.categoriaId && produto.categoriaId.toString() === c._id.toString() ? 'selected' : '' %>>
                        <%= c.nome %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label for="vendedorId">Vendedor</label>
            <select id="vendedorId" name="vendedorId">
                <option value="">-- Nenhum --</option>
                <% vendedores.forEach(v => { %>
                    <option value="<%= v._id %>" <%= produto.vendedorId && produto.vendedorId.toString() === v._id.toString() ? 'selected' : '' %>>
                        <%= v.nome %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group full-width">
            <label for="descricao">Descrição</label>
            <input type="text" id="descricao" name="descricao" value="<%= produto.descricao || '' %>">
        </div>

        <div class="actions full-width">
            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            <a href="/produtos" class="btn btn-secondary">Voltar para Produtos</a>
        </div>
    </form>
</section>

<%- include('partials/footer') %>