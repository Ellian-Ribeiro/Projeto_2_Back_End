<%- include('partials/header') %>

<h1>Gerenciar Vendedores</h1>

<div class="grid-2">
    <section class="card">
        <h2><%= vendedorEmEdicao ? 'Atualizar Vendedor' : 'Novo Vendedor' %></h2>
        <form action="<%= vendedorEmEdicao ? '/vendedores/atualizar' : '/vendedores' %>" method="POST" class="form-stack">
            <% if (vendedorEmEdicao) { %>
                <input type="hidden" name="id" value="<%= vendedorEmEdicao._id %>">
            <% } %>

            <div class="form-group">
                <label for="nome">Nome *</label>
                <input type="text" id="nome" name="nome" value="<%= vendedorEmEdicao ? vendedorEmEdicao.nome : '' %>" placeholder="Ex: Tech Store">
            </div>

            <div class="form-group">
                <label for="email">E-mail *</label>
                <input type="text" id="email" name="email" value="<%= vendedorEmEdicao ? vendedorEmEdicao.email : '' %>" placeholder="contato@loja.com">
            </div>

            <div class="form-group">
                <label for="documento">CPF / CNPJ</label>
                <input type="text" id="documento" name="documento" value="<%= vendedorEmEdicao ? (vendedorEmEdicao.documento || '') : '' %>" placeholder="00.000.000/0001-00">
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <%= vendedorEmEdicao ? 'Salvar Alterações' : 'Cadastrar Vendedor' %>
                </button>
                <% if (vendedorEmEdicao) { %>
                    <a href="/vendedores" class="btn btn-secondary">Cancelar</a>
                <% } %>
            </div>
        </form>
    </section>

    <section class="card">
        <h2>Buscar Vendedores (GET)</h2>
        <form action="/vendedores" method="GET" class="search-bar">
            <input type="text" name="busca" value="<%= busca %>" placeholder="Pesquisar por nome, e-mail ou documento...">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a href="/vendedores" class="btn btn-secondary">Limpar</a>
        </form>

        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Documento</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (vendedores.length === 0) { %>
                    <tr>
                        <td colspan="4">Nenhum vendedor encontrado.</td>
                    </tr>
                <% } else { %>
                    <% vendedores.forEach(v => { %>
                        <tr>
                            <td><strong><%= v.nome %></strong></td>
                            <td><%= v.email %></td>
                            <td><%= v.documento || '-' %></td>
                            <td class="table-actions">
                                <a href="/vendedores/<%= v._id %>" class="btn btn-secondary btn-sm">Editar</a>
                                <form action="/vendedores/excluir" method="POST" class="inline-form">
                                    <input type="hidden" name="id" value="<%= v._id %>">
                                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </section>
</div>

<%- include('partials/footer') %>